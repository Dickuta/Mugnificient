# Dockerfile for Production-like Testing
# Multi-stage build that includes testing capabilities

# Build args for frontend
ARG VITE_APP_NAME=Mugnificent
ARG VITE_APP_PRIMARY_COLOR=#003366
ARG VITE_APP_SECONDARY_COLOR=#D4AF37

# Build stage for frontend
FROM node:18-alpine as frontend-builder

WORKDIR /frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .

# Set build args for frontend
ARG VITE_APP_NAME
ARG VITE_APP_PRIMARY_COLOR
ARG VITE_APP_SECONDARY_COLOR

ENV VITE_APP_NAME=${VITE_APP_NAME}
ENV VITE_APP_PRIMARY_COLOR=${VITE_APP_PRIMARY_COLOR}
ENV VITE_APP_SECONDARY_COLOR=${VITE_APP_SECONDARY_COLOR}

RUN npm run build

# Production stage with test capabilities
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    nginx \
    && rm -rf /var/lib/apt/lists

# Copy backend
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install test dependencies
RUN pip install --no-cache-dir pytest pytest-asyncio httpx

COPY backend/ .

# Copy tests
COPY tests/ /app/tests/

# Copy frontend build
COPY --from=frontend-builder /frontend/dist/spa /var/www/html

# Configure nginx
RUN echo "server { \
    listen 80; \
    server_name localhost; \
    root /var/www/html; \
    index index.html; \
    location / { \
        try_files \$uri \$uri/ /index.html; \
    } \
    location /api { \
        proxy_pass http://127.0.0.1:8000; \
        proxy_set_header Host \$host; \
        proxy_set_header X-Real-IP \$remote_addr; \
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto \$scheme; \
    } \
    location /docs { \
        proxy_pass http://127.0.0.1:8000; \
    } \
    location /redoc { \
        proxy_pass http://127.0.0.1:8000; \
    } \
}" > /etc/nginx/sites-available/default

RUN ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

RUN mkdir -p /app/images

ENV PYTHONUNBUFFERED=1
ENV USE_SQLITE=true

EXPOSE 80 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Start script that can run tests or the app
COPY deployment/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
