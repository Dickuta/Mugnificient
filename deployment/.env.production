# Production Environment Variables
# Copy this file to .env and fill in the values

# =====================
# BACKEND
# =====================

# Database
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_USER=mugstore
POSTGRES_DB=mugstore

# Security - Generate a random secret key (min 32 chars)
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY

# CORS - Your production domain
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Admin email for alerts
ADMIN_EMAIL=admin@yourdomain.com

# =====================
# STORAGE - MinIO (S3-compatible)
# =====================

# Use S3 storage (set to true to use MinIO)
USE_S3=true

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
S3_BUCKET=mugnificent
S3_REGION=us-east-1

# =====================
# CACHE - Redis
# =====================

# Use Redis caching (set to false to use in-memory cache)
USE_REDIS=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================
# FRONTEND
# =====================

# App branding (optional)
VITE_APP_NAME=Mugnificent
VITE_APP_PRIMARY_COLOR=#003366
VITE_APP_SECONDARY_COLOR=#D4AF37

# API URL (auto-detected in production)
VITE_API_URL=https://yourdomain.com

# =====================
# MONITORING
# =====================

GRAFANA_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
